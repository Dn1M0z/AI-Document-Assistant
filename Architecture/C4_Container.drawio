<mxfile host="app.diagrams.net"><diagram id="c4-container" name="C4 Container Diagram"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;C4 Container Diagram — AI Document Assistant&lt;/b&gt;" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=10;text;fillColor=none;strokeColor=none;fontSize=24;"><mxGeometry x="400" y="10" width="1240" height="45" as="geometry"/></mxCell><mxCell id="reader" value="&lt;b&gt;Reader&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;Asks questions and checks sources." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=10;shape=mermaidPerson;perimeter=mermaidPersonPerimeter;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;strokeWidth=2;"><mxGeometry x="440" y="70" width="220" height="180" as="geometry"/></mxCell><mxCell id="manager" value="&lt;b&gt;Document Manager&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;Reader access plus document management." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=10;shape=mermaidPerson;perimeter=mermaidPersonPerimeter;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;strokeWidth=2;"><mxGeometry x="910" y="70" width="220" height="180" as="geometry"/></mxCell><mxCell id="admin" value="&lt;b&gt;Administrator&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;Manager access plus accounts, roles and audits." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=10;shape=mermaidPerson;perimeter=mermaidPersonPerimeter;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;strokeWidth=2;"><mxGeometry x="1380" y="70" width="220" height="180" as="geometry"/></mxCell><mxCell id="boundary" value="&lt;b&gt;AI Document Assistant&lt;/b&gt; [Software System]" vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=10;swimlane;startSize=40;horizontal=1;container=1;pointerEvents=0;collapsible=0;dashed=1;fillColor=none;swimlaneFillColor=none;strokeColor=#64748B;align=left;"><mxGeometry x="400" y="450" width="1240" height="900" as="geometry"/></mxCell><mxCell id="frontend" value="&lt;b&gt;Web frontend&lt;/b&gt;&lt;br&gt;[Container: React, TypeScript, PDF.js]&lt;br&gt;Browser UI for documents, questions, answers and source highlights." vertex="1" parent="boundary" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=10;rounded=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;strokeWidth=2;"><mxGeometry x="460" y="65" width="320" height="145" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;Backend API&lt;/b&gt;&lt;br&gt;[Container: Python, FastAPI]&lt;br&gt;Enforces access; manages documents; retrieves evidence and validates answers." vertex="1" parent="boundary" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=10;rounded=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;strokeWidth=2;"><mxGeometry x="40" y="330" width="240" height="155" as="geometry"/></mxCell><mxCell id="worker" value="&lt;b&gt;Ingestion worker&lt;/b&gt;&lt;br&gt;[Container: Python]&lt;br&gt;Claims jobs; extracts PDF text and positions; chunks and embeds." vertex="1" parent="boundary" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=10;rounded=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;strokeWidth=2;"><mxGeometry x="960" y="330" width="240" height="155" as="geometry"/></mxCell><mxCell id="files" value="&lt;b&gt;Document storage&lt;/b&gt;&lt;br&gt;[Container: Private filesystem]&lt;br&gt;Original PDFs for processing and authorised viewing." vertex="1" parent="boundary" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=10;shape=cylinder3;size=15;fillColor=#E6EFFA;strokeColor=#1168BD;fontColor=#16324F;strokeWidth=2;"><mxGeometry x="470" y="285" width="260" height="125" as="geometry"/></mxCell><mxCell id="sqlite" value="&lt;b&gt;Metadata database&lt;/b&gt;&lt;br&gt;[Container: SQLite]&lt;br&gt;Accounts, sessions, documents, jobs, chunks, source positions and audits." vertex="1" parent="boundary" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=10;shape=cylinder3;size=15;fillColor=#E6EFFA;strokeColor=#1168BD;fontColor=#16324F;strokeWidth=2;"><mxGeometry x="470" y="520" width="260" height="145" as="geometry"/></mxCell><mxCell id="qdrant" value="&lt;b&gt;Vector store&lt;/b&gt;&lt;br&gt;[Container: Qdrant]&lt;br&gt;Chunk embeddings and identifiers for filtered similarity search." vertex="1" parent="boundary" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=10;shape=cylinder3;size=15;fillColor=#E6EFFA;strokeColor=#1168BD;fontColor=#16324F;strokeWidth=2;"><mxGeometry x="470" y="735" width="260" height="125" as="geometry"/></mxCell><mxCell id="provider" value="&lt;b&gt;External Model Provider&lt;/b&gt;&lt;br&gt;[External Software System]&lt;br&gt;Generates answers from questions and retrieved evidence." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=10;rounded=1;fillColor=#777777;strokeColor=#555555;fontColor=#FFFFFF;strokeWidth=2;"><mxGeometry x="0" y="777" width="210" height="160" as="geometry"/></mxCell><mxCell id="reader_ui" value="Selects sources; asks questions; checks citations" edge="1" parent="1" source="reader" target="frontend" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=14;whiteSpace=wrap;labelWidth=175;align=center;labelBackgroundColor=default;defaultLabelBackgroundColor=page;exitX=0.5;exitY=1;entryX=0.1;entryY=0;"><mxGeometry x="-0.65" relative="1" as="geometry"/></mxCell><mxCell id="manager_ui" value="Uses Reader features; manages documents" edge="1" parent="1" source="manager" target="frontend" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=14;whiteSpace=wrap;labelWidth=175;align=center;labelBackgroundColor=default;defaultLabelBackgroundColor=page;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry x="-0.65" relative="1" as="geometry"/></mxCell><mxCell id="admin_ui" value="Uses manager features; administers accounts and audits" edge="1" parent="1" source="admin" target="frontend" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=14;whiteSpace=wrap;labelWidth=175;align=center;labelBackgroundColor=default;defaultLabelBackgroundColor=page;exitX=0.5;exitY=1;entryX=0.9;entryY=0;"><mxGeometry x="-0.65" relative="1" as="geometry"/></mxCell><mxCell id="ui_api" value="Submits requests; retrieves results and PDFs&lt;br&gt;[HTTPS: JSON / files]" edge="1" parent="boundary" source="frontend" target="api" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=14;whiteSpace=wrap;labelWidth=175;align=center;labelBackgroundColor=default;defaultLabelBackgroundColor=page;exitX=0;exitY=0.5;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="api_files" value="Stores, serves and deletes PDFs&lt;br&gt;[Filesystem]" edge="1" parent="boundary" source="api" target="files" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=14;whiteSpace=wrap;labelWidth=175;align=center;labelBackgroundColor=default;defaultLabelBackgroundColor=page;exitX=1;exitY=0.15;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="worker_files" value="Reads PDFs for extraction&lt;br&gt;[Filesystem]" edge="1" parent="boundary" source="worker" target="files" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=14;whiteSpace=wrap;labelWidth=175;align=center;labelBackgroundColor=default;defaultLabelBackgroundColor=page;exitX=0;exitY=0.15;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="api_sqlite" value="Reads/writes accounts, jobs and source records&lt;br&gt;[SQL: local driver]" edge="1" parent="boundary" source="api" target="sqlite" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=14;whiteSpace=wrap;labelWidth=175;align=center;labelBackgroundColor=default;defaultLabelBackgroundColor=page;exitX=1;exitY=0.65;entryX=0;entryY=0.35;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="worker_sqlite" value="Claims jobs; writes chunks and processing state&lt;br&gt;[SQL: local driver]" edge="1" parent="boundary" source="worker" target="sqlite" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=14;whiteSpace=wrap;labelWidth=175;align=center;labelBackgroundColor=default;defaultLabelBackgroundColor=page;exitX=0;exitY=0.65;entryX=1;entryY=0.35;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="api_qdrant" value="Searches selected sources; deletes vectors&lt;br&gt;[HTTP / JSON]" edge="1" parent="boundary" source="api" target="qdrant" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=14;whiteSpace=wrap;labelWidth=175;align=center;labelBackgroundColor=default;defaultLabelBackgroundColor=page;exitX=0.5;exitY=1;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="worker_qdrant" value="Indexes embeddings; cleans incomplete work&lt;br&gt;[HTTP / JSON]" edge="1" parent="boundary" source="worker" target="qdrant" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=14;whiteSpace=wrap;labelWidth=175;align=center;labelBackgroundColor=default;defaultLabelBackgroundColor=page;exitX=0.5;exitY=1;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="api_provider" value="Requests grounded answers&lt;br&gt;[HTTPS API]" edge="1" parent="1" source="api" target="provider" style="html=1;rounded=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=1.5;fontSize=14;whiteSpace=wrap;align=center;labelBackgroundColor=default;defaultLabelBackgroundColor=page;exitX=0;exitY=0.5;entryX=1;entryY=0.5;labelWidth=140;"><mxGeometry x="0.15" relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Key&lt;/b&gt; — Person: user role · Blue box: application container · Cylinder: data-store container · Grey box: external system&lt;br&gt;Dashed outline: software-system boundary · Arrow: directed interaction; normal responses are implied.&lt;br&gt;API and worker coordinate through SQLite jobs. Embeddings run inside these applications. All active roles read the shared collection." vertex="1" parent="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=10;text;fillColor=none;strokeColor=none;fontSize=14;"><mxGeometry x="400" y="1375" width="1240" height="95" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
