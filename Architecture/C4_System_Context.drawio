<mxfile host="app.diagrams.net"><diagram id="c4-system-context" name="C4 System Context"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v_e52f60b4" value="System Context Diagram — AI Document Assistant" style="text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="760" height="35" as="geometry"/></mxCell><mxCell id="v_9ff36378" value="&lt;b&gt;Reader&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Reads shared documents, asks questions and checks cited sources." style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=2;shape=mermaidPerson;perimeter=mermaidPersonPerimeter;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="20" y="65" width="220" height="195" as="geometry"/></mxCell><mxCell id="v_d0640008" value="&lt;b&gt;Document Manager&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Has Reader permissions and manages the shared document collection." style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=2;shape=mermaidPerson;perimeter=mermaidPersonPerimeter;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="290" y="65" width="220" height="195" as="geometry"/></mxCell><mxCell id="v_19021738" value="&lt;b&gt;Administrator&lt;/b&gt;&lt;br&gt;[Person]&lt;br&gt;&lt;br&gt;Has Document Manager permissions and manages accounts, roles and audit access." style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=2;shape=mermaidPerson;perimeter=mermaidPersonPerimeter;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="560" y="65" width="220" height="195" as="geometry"/></mxCell><mxCell id="v_2f8a8ce4" value="&lt;b&gt;AI Document Assistant&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;System in scope. Provides document-grounded answers with verifiable citations and enforces permissions.&lt;br&gt;&lt;br&gt;This box defines the system boundary." style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=2;rounded=1;arcSize=12;fillColor=#1168BD;strokeColor=#3C7FC0;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="250" y="440" width="300" height="180" as="geometry"/></mxCell><mxCell id="v_d9533962" value="&lt;b&gt;External Model Provider&lt;/b&gt;&lt;br&gt;[Software System]&lt;br&gt;&lt;br&gt;External dependency that generates answers from supplied questions and evidence." style="html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;spacing=10;strokeWidth=2;rounded=1;arcSize=12;fillColor=#999999;strokeColor=#8A8A8A;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="250" y="735" width="300" height="135" as="geometry"/></mxCell><mxCell id="e_9a977cec" value="Selects documents, asks questions and views cited answers" edge="1" parent="1" source="v_9ff36378" target="v_2f8a8ce4" style="html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=13;whiteSpace=wrap;labelWidth=190;labelBackgroundColor=default;defaultLabelBackgroundColor=page;exitX=0.5;exitY=1;entryX=0.1;entryY=0;align=center;verticalAlign=middle;"><mxGeometry x="-0.5" relative="1" as="geometry"/></mxCell><mxCell id="e_e6a46310" value="Uses Reader features; uploads, retries and deletes documents" edge="1" parent="1" source="v_d0640008" target="v_2f8a8ce4" style="html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=13;whiteSpace=wrap;labelWidth=200;labelBackgroundColor=default;defaultLabelBackgroundColor=page;exitX=0.5;exitY=1;entryX=0.5;entryY=0;align=center;verticalAlign=middle;"><mxGeometry x="-0.5" relative="1" as="geometry"/></mxCell><mxCell id="e_b8a1cc9c" value="Uses manager features; manages accounts, roles and views audits" edge="1" parent="1" source="v_19021738" target="v_2f8a8ce4" style="html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=13;whiteSpace=wrap;labelWidth=200;labelBackgroundColor=default;defaultLabelBackgroundColor=page;exitX=0.5;exitY=1;entryX=0.9;entryY=0;align=center;verticalAlign=middle;"><mxGeometry x="-0.5" relative="1" as="geometry"/></mxCell><mxCell id="e_89e242c0" value="Requests answers using questions and retrieved evidence" edge="1" parent="1" source="v_2f8a8ce4" target="v_d9533962" style="html=1;endArrow=block;endFill=1;strokeColor=#444444;strokeWidth=1.5;fontSize=13;whiteSpace=wrap;labelWidth=270;labelBackgroundColor=default;defaultLabelBackgroundColor=page;exitX=0.5;exitY=1;entryX=0.5;entryY=0;align=center;verticalAlign=middle;"><mxGeometry x="0" relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Key&lt;/b&gt; — Person silhouette: user role · Blue system: in scope · Grey system: external dependency&lt;br&gt;Arrow: directed interaction or dependency. All active roles can read the shared collection." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="895" width="760" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
