ontSize=16;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=25;fillColor=#EEF4FF;strokeColor=#9DB8F2;strokeWidth=1.5;"><mxGeometry x="80" y="1460" width="240" height="120" as="geometry"/></mxCell><mxCell id="retryAllowed" parent="api" vertex="1" value="Retry allowed and attempt created?" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;rhombus;fillColor=#FFF6E0;strokeColor=#E8C36A;strokeWidth=1.5;"><mxGeometry x="80" y="1640" width="240" height="110" as="geometry"/></mxCell><mxCell id="retryRejected" parent="ui" vertex="1" value="Show retry rejection; leave existing state unchanged" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;rounded=1;fillColor=#FDECEC;strokeColor=#EBA3A3;strokeWidth=1.5;"><mxGeometry x="30" y="1755" width="220" height="100" as="geometry"/></mxCell><mxCell id="retryEnd" parent="ui" vertex="1" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;shape=endState;fillColor=#1B1F24;strokeColor=#1B1F24;"><mxGeometry x="125" y="1890" width="25" height="25" as="geometry"/></mxCell><mxCell id="limitsNote" parent="api" vertex="1" value="Limits: 10,000,000 bytes per PDF; 20 stored documents. Reserve capacity transactionally." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;text;fillColor=none;strokeColor=none;fontSize=13;"><mxGeometry x="20" y="80" width="360" height="55" as="geometry"/></mxCell><mxCell id="validationNote" parent="worker" vertex="1" value="Reject corrupted or password-protected PDFs. No OCR. Record warnings for image-only pages when other usable text exists." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;shape=note;fillColor=#FFF6E0;strokeColor=#E8C36A;fontSize=14;"><mxGeometry x="600" y="980" width="310" height="105" as="geometry"/></mxCell><mxCell id="deletionNote" parent="worker" vertex="1" value="Deletion immediately removes eligibility. Late completion cannot restore a deleted document. Cleanup is retryable; failures never make partial chunks searchable." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;shape=note;fillColor=#FFF6E0;strokeColor=#E8C36A;fontSize=14;"><mxGeometry x="600" y="2050" width="310" height="120" as="geometry"/></mxCell><mxCell id="legend" parent="1" vertex="1" value="&lt;b&gt;Key:&lt;/b&gt; filled circle = start; bullseye = activity end; rounded box = action; diamond = decision; [text] = branch guard; swimlane = responsible actor.&lt;br&gt;Processing failures include extraction, embedding and storage errors. No partial generation becomes searchable. Diagram describes planned behaviour, not implemented test results." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;text;fillColor=none;strokeColor=none;fontSize=14;"><mxGeometry x="0" y="2330" width="2290" height="90" as="geometry"/></mxCell><mxCell id="flow1" parent="user" edge="1" source="start" target="select" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=open;strokeColor=#475569;strokeWidth=1.5;fontSize=14;labelBackgroundColor=default;defaultLabelBackgroundColor=page;exitX=0.5;exitY=1;entryX=0.4772727272727273;entryY=0;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;"><mxGeometry relative="1" x="0" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="flow2" parent="1" edge="1" source="select" target="submit" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=open;strokeColor=#475569;strokeWidth=1.5;fontSize=14;labelBackgroundColor=default;defaultLabelBackgroundColor=page;libavoidRouting=1;orthogonalLoop=1;jettySize=auto;"><mxGeometry relative="1" x="0" as="geometry"><Array as="points"></Array></mxGeometry></mxCell><mxCell id="flow3" parent="1" edge="1" sourc