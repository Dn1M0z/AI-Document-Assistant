idth=1.5;"><mxGeometry x="300" y="825" width="180" height="90" as="geometry"/></mxCell><mxCell id="claim" parent="worker" vertex="1" value="Claim job with lease; set Processing" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=25;fillColor=#EEF4FF;strokeColor=#9DB8F2;strokeWidth=1.5;"><mxGeometry x="40" y="825" width="250" height="90" as="geometry"/></mxCell><mxCell id="pdf" parent="worker" vertex="1" value="Valid supported PDF; at most 100 pages?" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;rhombus;fillColor=#FFF6E0;strokeColor=#E8C36A;strokeWidth=1.5;"><mxGeometry x="45" y="980" width="240" height="110" as="geometry"/></mxCell><mxCell id="extract" parent="worker" vertex="1" value="Extract text, PDF pages and source coordinates" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=25;fillColor=#EEF4FF;strokeColor=#9DB8F2;strokeWidth=1.5;"><mxGeometry x="40" y="1150" width="250" height="80" as="geometry"/></mxCell><mxCell id="usable" parent="worker" vertex="1" value="Usable text exists?" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;rhombus;fillColor=#FFF6E0;strokeColor=#E8C36A;strokeWidth=1.5;"><mxGeometry x="45" y="1280" width="240" height="100" as="geometry"/></mxCell><mxCell id="index" parent="worker" vertex="1" value="Create page-aware chunks; embed; store metadata and vectors" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=25;fillColor=#EEF4FF;strokeColor=#9DB8F2;strokeWidth=1.5;"><mxGeometry x="40" y="1440" width="250" height="100" as="geometry"/></mxCell><mxCell id="outcome" parent="worker" vertex="1" value="Processing outcome?" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;rhombus;fillColor=#FFF6E0;strokeColor=#E8C36A;strokeWidth=1.5;"><mxGeometry x="45" y="1605" width="240" height="100" as="geometry"/></mxCell><mxCell id="current" parent="worker" vertex="1" value="Document exists and job generation is current?" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;rhombus;fillColor=#FFF6E0;strokeColor=#E8C36A;strokeWidth=1.5;"><mxGeometry x="45" y="1775" width="240" height="110" as="geometry"/></mxCell><mxCell id="ready" parent="worker" vertex="1" value="Atomically publish Ready generation" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;rounded=1;fillColor=#E7F6EC;strokeColor=#8BCB9F;strokeWidth=1.5;"><mxGeometry x="40" y="1960" width="250" height="80" as="geometry"/></mxCell><mxCell id="display" parent="ui" vertex="1" value="Display Ready and any image-only page warnings" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;rounded=1;fillColor=#E7F6EC;strokeColor=#8BCB9F;strokeWidth=1.5;"><mxGeometry x="30" y="1960" width="220" height="80" as="geometry"/></mxCell><mxCell id="end" parent="ui" vertex="1" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;shape=endState;fillColor=#1B1F24;strokeColor=#1B1F24;"><mxGeometry x="125" y="2100" width="30" height="30" as="geometry"/></mxCell><mxCell id="failed" parent="worker" vertex="1" value="If document/job still current: set Failed with reason; keep partial results unsearchable" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;rounded=1;fillColor=#FDECEC;strokeColor=#EBA3A3;strokeWidth=1.5;"><mxGeometry x="650" y="1160" width="260" height="120" as="geometry"/></mxCell><mxCell id="recover" parent="worker" vertex="1" value="On expired lease: recover safely or mark Failed; reject stale worker writes" style="html=1;whiteSpace=wrap;f