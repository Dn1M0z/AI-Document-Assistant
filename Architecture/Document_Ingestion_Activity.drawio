<mxfile host="app.diagrams.net"><diagram id="document-ingestion" name="Document ingestion"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" vertex="1" value="&lt;b&gt;Document ingestion — UML activity diagram&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;text;fillColor=none;strokeColor=none;fontSize=24;"><mxGeometry x="0" y="0" width="2290" height="45" as="geometry"/></mxCell><mxCell id="scope" parent="1" vertex="1" value="Per-file lifecycle: a multi-file upload creates an independent flow for each file. The worker processes one document at a time." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;text;fillColor=none;strokeColor=none;"><mxGeometry x="0" y="45" width="2290" height="45" as="geometry"/></mxCell><mxCell id="user" parent="1" vertex="1" value="Document Manager / Administrator" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;swimlane;startSize=55;horizontal=1;container=1;pointerEvents=0;collapsible=0;fillColor=#F2F4F7;swimlaneFillColor=#FFFFFF;strokeColor=#B8C0CC;fontStyle=1;"><mxGeometry x="0" y="105" width="250" height="2200" as="geometry"/></mxCell><mxCell id="ui" parent="1" vertex="1" value="Frontend" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;swimlane;startSize=55;horizontal=1;container=1;pointerEvents=0;collapsible=0;fillColor=#F2F4F7;swimlaneFillColor=#FFFFFF;strokeColor=#B8C0CC;fontStyle=1;"><mxGeometry x="250" y="105" width="400" height="2200" as="geometry"/></mxCell><mxCell id="api" parent="1" vertex="1" value="Backend API" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;swimlane;startSize=55;horizontal=1;container=1;pointerEvents=0;collapsible=0;fillColor=#F2F4F7;swimlaneFillColor=#FFFFFF;strokeColor=#B8C0CC;fontStyle=1;"><mxGeometry x="650" y="105" width="600" height="2200" as="geometry"/></mxCell><mxCell id="worker" parent="1" vertex="1" value="Ingestion worker" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;swimlane;startSize=55;horizontal=1;container=1;pointerEvents=0;collapsible=0;fillColor=#F2F4F7;swimlaneFillColor=#FFFFFF;strokeColor=#B8C0CC;fontStyle=1;"><mxGeometry x="1250" y="105" width="1040" height="2200" as="geometry"/></mxCell><mxCell id="start" parent="user" vertex="1" value="" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;ellipse;fillColor=#1B1F24;strokeColor=#1B1F24;"><mxGeometry x="105" y="80" width="30" height="30" as="geometry"/></mxCell><mxCell id="select" parent="user" vertex="1" value="Select PDFs and upload" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=25;fillColor=#EEF4FF;strokeColor=#9DB8F2;strokeWidth=1.5;"><mxGeometry x="15" y="155" width="220" height="80" as="geometry"/></mxCell><mxCell id="submit" parent="ui" vertex="1" value="Submit each file" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;rounded=1;arcSize=25;fillColor=#EEF4FF;strokeColor=#9DB8F2;strokeWidth=1.5;"><mxGeometry x="30" y="155" width="220" height="80" as="geometry"/></mxCell><mxCell id="auth" parent="api" vertex="1" value="Active session and upload permission?" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;rhombus;fillColor=#FFF6E0;strokeColor=#E8C36A;strokeWidth=1.5;"><mxGeometry x="80" y="145" width="240" height="110" as="geometry"/></mxCell><mxCell id="reject" parent="ui" vertex="1" value="Reject this file; explain reason" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=16;align=center;verticalAlign=middle;spacing=8;rounded=1;fillColor=#FDECEC;strokeColo